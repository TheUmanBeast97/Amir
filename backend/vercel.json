{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [
    { "path": "/api/v1/cron/current", "schedule": "0 4 * * *" },
    { "path": "/api/v1/cron/details", "schedule": "20 4 * * *" },
    { "path": "/api/v1/cron/media", "schedule": "40 4 * * *" },
    { "path": "/api/v1/cron/stats", "schedule": "0 5 * * *" },
    { "path": "/api/v1/cron/history", "schedule": "0 3 * * 1" },
    { "path": "/api/v1/cron/zone", "schedule": "30 3 * * *" }
  ]
}
