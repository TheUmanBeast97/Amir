APP_NAME="AMIR Team Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Rome

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

# --- AMIR Team Manager ---
# L amministratore NON va qui: si crea con "php artisan amir:admin tua@email.it" (la password si digita a terminale)
# Indirizzo del frontend: serve per i link personali dei giocatori (/p/{token})
FRONTEND_URL=http://localhost:8080
# Solo online (Vercel, vedi docs/DEPLOY.md). Tutto il resto lo imposta backend/api/index.php.
# AMIR_ADMIN_EMAIL=               primo amministratore (con la sua impronta, mai la password)
# AMIR_ADMIN_HASH=                si calcola con `php artisan amir:hash`
# CRON_SECRET=                    accende gli aggiornamenti notturni da XFive (stringa lunga a caso)
# Pausa fra le richieste a XFive, in millisecondi
XFIVE_THROTTLE_MS=1200

# Testi scritti dall'IA (didascalie dello Studio grafiche, schede dei giocatori): Gemini di Google.
# Chiave gratuita da https://aistudio.google.com/apikey . Senza chiave si usano dei modelli di testo, e lo Studio lo dice.
GEMINI_API_KEY=
# Modello gratuito (predefinito gemini-3.5-flash); più veloce e leggero: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Online: restringere l API al solo sito (facoltativa), vedi docs/DEPLOY.md
# CORS_ALLOWED_ORIGINS=https://amir-taupe.vercel.app
